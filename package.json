{
  "name": "github-repo-manager",
  "private": false,
  "version": "3.0.0",
  "type": "module",
  "description": "Modern GitHub repository management dashboard with AI-powered insights, team collaboration, and Azure DevOps migration",
  "author": "Bruno Marques - Bola Labs, Inc.",
  "license": "AGPL-3.0-only",
  "keywords": [
    "github",
    "dashboard",
    "repository-management",
    "react",
    "ai",
    "devops"
  ],
  "homepage": "https://github.com/brunobola-portfolio/GitHub-Repo-Manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/brunobola-portfolio/GitHub-Repo-Manager.git"
  },
  "bugs": {
    "url": "https://github.com/brunobola-portfolio/GitHub-Repo-Manager/issues"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server/index.js",
    "check:native": "node server/check-native-modules.js",
    "fix:native": "node server/check-native-modules.js --fix",
    "postinstall": "node server/check-native-modules.js || echo 'Run npm run fix:native to rebuild native modules'",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "playwright:install": "playwright install"
  },
  "dependencies": {
    "@git-diff-view/react": "^0.1.3",
    "@git-diff-view/shiki": "^0.1.3",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@sentry/node": "^10.47.0",
    "@sentry/react": "^10.47.0",
    "@tanstack/react-virtual": "^3.13.23",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.6.2",
    "bullmq": "^5.72.1",
    "clsx": "^2.1.1",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.1",
    "framer-motion": "^12.23.24",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "lucide-react": "^0.554.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "rate-limit-redis": "^4.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.5.1",
    "shiki": "^4.0.2",
    "simple-git": "^3.32.3",
    "stripe": "^21.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.6.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.17",
    "vite": "^7.3.2",
    "vitest": "^4.0.18"
  }
}
