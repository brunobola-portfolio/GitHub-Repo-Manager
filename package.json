{
  "name": "github-repo-manager",
  "private": false,
  "version": "4.11.0",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "description": "Modern GitHub repository management dashboard with AI-powered insights, team collaboration, and Azure DevOps migration",
  "author": "Bruno Marques - Bola Labs, Inc.",
  "license": "AGPL-3.0-only",
  "keywords": [
    "github",
    "dashboard",
    "repository-management",
    "react",
    "ai",
    "devops"
  ],
  "homepage": "https://github.com/brunobola-portfolio/GitHub-Repo-Manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/brunobola-portfolio/GitHub-Repo-Manager.git"
  },
  "bugs": {
    "url": "https://github.com/brunobola-portfolio/GitHub-Repo-Manager/issues"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "vite",
    "dev:server": "node server/index.js",
    "dev:all": "node scripts/dev.mjs",
    "dev:all:debug": "node scripts/dev.mjs --debug",
    "dev:kill": "node scripts/kill-dev-ports.js",
    "build": "vite build",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "lint": "eslint . --max-warnings 0",
    "guards": "node scripts/check-debug-statements.mjs --all && node scripts/check-no-static-mock-imports.mjs --all && node scripts/check-no-raw-z-index.mjs --all",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "db:init": "node -e \"import('./server/db.js').then(m => { m.initDB(); console.log('DB initialised'); process.exit(0); })\"",
    "preview": "vite preview",
    "start": "node server/index.js",
    "check:native": "node server/check-native-modules.js",
    "fix:native": "node server/check-native-modules.js --fix",
    "postinstall": "node server/check-native-modules.js || echo 'Run npm run fix:native to rebuild native modules'",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "playwright:install": "playwright install",
    "test:evals": "node server/evals/run.js",
    "test:evals:real": "node server/evals/run.js --real",
    "retention:run": "node server/scripts/retention.js",
    "retention:dry": "node server/scripts/retention.js --dry-run",
    "admin:grant": "node server/scripts/admin-grant.mjs",
    "audit:verify": "node server/scripts/verify-audit-chain.mjs",
    "admin:revoke": "node server/scripts/admin-grant.mjs --revoke",
    "admin:dlq": "node server/scripts/admin-dlq.mjs",
    "admin:dlq:sweep": "node server/scripts/dlq-sweep.mjs",
    "lint:css": "node scripts/check-killed-classes.mjs",
    "prebuild": "npm run lint:css",
    "doctor": "node scripts/doctor.mjs",
    "doctor:fix": "node scripts/doctor.mjs --fix",
    "docs:linkcheck": "node scripts/check-doc-links.mjs"
  },
  "dependencies": {
    "@git-diff-view/react": "^0.1.7",
    "@git-diff-view/shiki": "^0.1.7",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@sentry/node": "^10.68.0",
    "@sentry/react": "^10.68.0",
    "@tanstack/react-virtual": "^3.14.8",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.9.0",
    "bullmq": "^5.81.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compression": "^1.8.1",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "framer-motion": "^12.42.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "mermaid": "^11.16.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "simple-git": "^3.36.0",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.10",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.17",
    "vite": "^8.1.5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "ip-address": "^10.1.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix --max-warnings 0",
      "node scripts/check-debug-statements.mjs",
      "node scripts/check-no-static-mock-imports.mjs",
      "node scripts/check-no-raw-z-index.mjs"
    ],
    "server/**/*.js": [
      "eslint --fix --max-warnings 0",
      "node scripts/check-debug-statements.mjs"
    ],
    "tests/**/*.{js,jsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "e2e/**/*.{js,jsx}": [
      "eslint --fix --max-warnings 0"
    ]
  }
}
