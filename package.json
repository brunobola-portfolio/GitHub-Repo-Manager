{
  "name": "github-repo-manager",
  "private": false,
  "version": "3.7.2",
  "type": "module",
  "description": "Modern GitHub repository management dashboard with AI-powered insights, team collaboration, and Azure DevOps migration",
  "author": "Bruno Marques - Bola Labs, Inc.",
  "license": "AGPL-3.0-only",
  "keywords": [
    "github",
    "dashboard",
    "repository-management",
    "react",
    "ai",
    "devops"
  ],
  "homepage": "https://github.com/brunobola-portfolio/GitHub-Repo-Manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/brunobola-portfolio/GitHub-Repo-Manager.git"
  },
  "bugs": {
    "url": "https://github.com/brunobola-portfolio/GitHub-Repo-Manager/issues"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "dev:server": "node server/index.js",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "dev:kill": "node scripts/kill-dev-ports.js",
    "build": "vite build",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "db:init": "node -e \"import('./server/db.js').then(m => { m.initDB(); console.log('DB initialised'); process.exit(0); })\"",
    "preview": "vite preview",
    "start": "node server/index.js",
    "check:native": "node server/check-native-modules.js",
    "fix:native": "node server/check-native-modules.js --fix",
    "postinstall": "node server/check-native-modules.js || echo 'Run npm run fix:native to rebuild native modules'",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "playwright:install": "playwright install",
    "test:evals": "node server/evals/run.js",
    "retention:run": "node server/scripts/retention.js",
    "retention:dry": "node server/scripts/retention.js --dry-run",
    "admin:grant": "node server/scripts/admin-grant.mjs",
    "admin:revoke": "node server/scripts/admin-grant.mjs --revoke",
    "admin:dlq": "node server/scripts/admin-dlq.mjs",
    "admin:dlq:sweep": "node server/scripts/dlq-sweep.mjs"
  },
  "dependencies": {
    "@git-diff-view/react": "^0.1.3",
    "@git-diff-view/shiki": "^0.1.3",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@sentry/node": "^10.49.0",
    "@sentry/react": "^10.49.0",
    "@tanstack/react-virtual": "^3.13.24",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.9.0",
    "bullmq": "^5.74.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.19.0",
    "framer-motion": "^12.38.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "lucide-react": "^1.8.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "rate-limit-redis": "^4.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "shiki": "^4.0.2",
    "simple-git": "^3.36.0",
    "stripe": "^22.0.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.10",
    "rollup-plugin-visualizer": "^7.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.17",
    "vite": "^8.0.8",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix --max-warnings 0",
      "node scripts/check-debug-statements.mjs"
    ],
    "server/**/*.js": [
      "eslint --fix --max-warnings 0",
      "node scripts/check-debug-statements.mjs"
    ],
    "tests/**/*.{js,jsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "e2e/**/*.{js,jsx}": [
      "eslint --fix --max-warnings 0"
    ]
  }
}
