node_modules
.git
.github
.gitattributes
.gitignore

# Local workspaces / personal tooling
.dev
.claude
.superpowers
.playwright-mcp
.worktrees
.agent
.roo
.augment

# Secrets — NEVER copy local env files into image
.env
.env.local
.env.*.local
.env.production
.env.development

# License signing private key — verification only needs keys/public.pem;
# keep the private key out of every build layer, including the builder stage
keys/private.pem

# Local DB files
server/data/*.db
server/data/tmp/
*.db
*.sqlite
*.sqlite3

# Build outputs / test artefacts
dist
dist-ssr
coverage
test-results
playwright-report

# Source code that isn't shipped at runtime
tests
e2e
docs
*.md
!README.md

# Editor
.vscode
.idea
.DS_Store

# Logs
*.log
