node_modules
.git
.github
.gitattributes
.gitignore

# Local workspaces / personal tooling
.dev
.claude
.superpowers
.playwright-mcp
.worktrees
.agent
.roo
.augment

# Secrets — NEVER copy local env files into image.
# A pattern, not an enumeration: Dockerfile stage 1 does `COPY . .`, so every
# name NOT listed here gets baked into an image layer where it survives even
# if a later stage never copies it forward.
.env*

# Key/certificate material — verification only needs keys/public.pem, which is
# public by definition and re-included below. `**/` because .dockerignore
# patterns do not cross directory separators: a bare `*.pem` would leave
# keys/private.pem and certs/*.pem in the context.
**/*.pem
**/*.key
**/*.crt
**/*.pfx
**/*.p12
**/*.jks
!keys/public.pem

# Local scratch that is gitignored (so it never shows up in review) but sits
# in the build context all the same. dados.txt holds a live license JWT.
dados.txt
plans
Implementation

# Local DB files
server/data/*.db
server/data/tmp/
*.db
*.sqlite
*.sqlite3

# Build outputs / test artefacts
dist
dist-ssr
coverage
test-results
playwright-report

# Source code that isn't shipped at runtime
tests
e2e
docs
*.md
!README.md

# Editor
.vscode
.idea
.DS_Store

# Logs
*.log
