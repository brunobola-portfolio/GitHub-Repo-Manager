<?xml version="1.0" encoding="utf-8"?>
<!--
  Reverse-proxy web.config for hosting GitHub Repo Manager behind IIS with
  Application Request Routing (ARR) + URL Rewrite. Drop it at the physical
  root of the IIS site whose binding is your public hostname.

  This site serves NO files. It is a pure proxy: every request is rewritten to
  the Node process on 127.0.0.1:3001, which serves both the built SPA (dist/)
  and /api/*. Do not add SPA fallback rules or point the site at dist/ —
  Express already handles both, and a second static handler would shadow it
  with a stale copy after every deploy.

  Prerequisites on the IIS host (see docs/guides/deploy-iis-windows.md):
    1. URL Rewrite 2.1 and ARR 3.0 installed.
    2. ARR proxy ENABLED  (IIS Manager > server node > Application Request
       Routing Cache > Server Proxy Settings > Enable proxy).
    3. Response buffer threshold set to 0, so SSE streams are not batched.
       ARR ignores X-Accel-Buffering; this is the only lever.
    4. HTTP_X_FORWARDED_PROTO added to <allowedServerVariables> in
       applicationHost.config, or the rule below fails with HTTP 500.19.
       That is the ONLY server variable this file sets.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!--
          HTTP -> HTTPS, and it MUST come first. The proxy rule below matches
          everything with stopProcessing="true", so a redirect rule placed
          after it would never run.

          /.well-known/acme-challenge/ is excluded, and that exclusion is what
          makes the FIRST certificate obtainable at all: an ACME HTTP-01
          challenge arrives over plain HTTP, and redirecting it to an https://
          binding that does not exist yet means the connection is refused and
          issuance fails. win-acme and every other ACME client hits this.

          Redirect is 302, not 301, for the same reason — a permanent redirect
          cached by a browser during the setup window is painful to undo.
          Switch it to Permanent once the site is stable if you want the SEO
          signal; HSTS (which the app sends) already does the real work.
        -->
        <rule name="GRM force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Found" />
        </rule>

        <!--
          ARR does not forward X-Forwarded-Proto (it sends X-ARR-SSL, which
          Express does not read), so `trust proxy` cannot tell the request
          arrived over TLS and the session cookie loses its Secure flag.
          This supplies it.

          Conditioned on {HTTPS}, NOT set unconditionally. The cookie is
          issued with `secure: 'auto'` (server/index.js), meaning Express
          stamps Secure whenever req.secure is true. Asserting https on a
          request that actually arrived over plain HTTP would make the browser
          receive a Secure cookie on an http:// origin — which it discards —
          so no session survives the GitHub redirect and every login dies with
          invalid_state.

          In practice the rule above already redirects plain HTTP away, so
          this condition is belt-and-braces: it keeps the header honest if the
          redirect is ever removed, reordered, or scoped.

          <set> assigns, it never appends, so a client-supplied
          X-Forwarded-Proto is replaced here and cannot reach Node. That
          matters: Express reads the FIRST value of the header, so an
          appending proxy would hand control of req.secure to the caller.
        -->
        <rule name="GRM reverse proxy to Node" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^ON$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!--
      Per-site ARR proxy tuning.

      responseBufferThreshold="0" is what makes Server-Sent Events (AI chat
      streaming, migration progress, assisted install) arrive chunk-by-chunk
      instead of as one delayed blob at the end of the response.

      httpVersion="Http11" pins the upstream conversation to HTTP/1.1. The
      default (PassThrough) mirrors the client, so an HTTP/1.0 client makes
      ARR speak 1.0 to Node — which has no chunked transfer encoding, and
      therefore no streaming at all.

      timeout is raised from the 2-minute default because a long AI generation
      or a large repository migration legitimately holds one response open for
      several minutes; at 00:02:00 the browser sees the stream cut mid-answer.

      preserveHostHeader="true" is load-bearing, not cosmetic: several checks
      read the Host header (server/lib/loopback.js gates the in-app OAuth
      setup endpoint on it). With the default false, ARR rewrites Host to
      127.0.0.1:3001 and that gate stops distinguishing anything. Do not drop
      this attribute when moving these settings to server level.

      NOTE: the <proxy> section may be locked to applicationHost.config on your
      IIS build. If IIS returns 500.19 "This configuration section cannot be
      used at this path", set the same FOUR values in Server Proxy Settings
      instead and delete this element — see the guide, which also covers
      `appcmd unlock`.
    -->
    <proxy enabled="true"
           preserveHostHeader="true"
           responseBufferThreshold="0"
           httpVersion="Http11"
           timeout="00:20:00" />

    <security>
      <requestFiltering>
        <!--
          30 MB. The app's own JSON caps are far lower (10 KB globally, 4 MB
          on AI routes — server/index.js), but repository imports and wiki
          uploads travel through the same pipe and IIS rejects oversized
          bodies before Node ever sees them, with an opaque 404.13.
        -->
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!--
          Express sends its own security headers via helmet. Drop the
          ASP.NET banner IIS would add after helmet has run. (This does not
          remove the `Server: Microsoft-IIS/x` header — that needs
          removeServerHeader in applicationHost.config.)
        -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!--
      Compression must stay OFF for this site. Express already compresses
      (server/index.js mounts `compression` with an explicit text/event-stream
      carve-out); letting IIS re-compress the proxied response re-buffers SSE
      and undoes that carve-out.
    -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />

  </system.webServer>
</configuration>
