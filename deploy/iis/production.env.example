# ============================================================================
# GitHub Repo Manager — production .env for a Windows/IIS reverse-proxy host
# ============================================================================
# Copy to the DATA directory (NOT the install directory) and point the service
# at it with GRM_ENV_FILE, so it survives a reinstall and the app folder can
# stay read-only:
#
#   copy deploy\iis\production.env.example C:\ProgramData\GitHubRepoManager\data\.env
#   node scripts\generate-secrets.mjs --append C:\ProgramData\GitHubRepoManager\data\.env
#
# Then lock it down — it holds the key that decrypts every stored credential:
#   icacls C:\ProgramData\GitHubRepoManager\data\.env /inheritance:r ^
#     /grant "SYSTEM:(R)" /grant "Administrators:(F)"
#
# Full walkthrough: docs/guides/deploy-iis-windows.md
# Every variable the server reads (with defaults): .env.example
# ----------------------------------------------------------------------------

# ─────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────
NODE_ENV=production

# Express serves BOTH the built SPA (dist/) and /api/* from this one port.
# IIS/ARR is the only thing that talks to it.
PORT=3001

# Bind loopback only. The public surface is the IIS site; leaving this unset
# would bind every interface and expose the app on the LAN, bypassing TLS,
# the WAF and the access logs.
HOST=127.0.0.1

# Public origin. Drives CORS, the helmet CSP connect-src, the OAuth
# redirect_uri scheme (server/routes/auth.js resolveCallbackOrigin) and every
# post-login redirect. Must match the IIS binding exactly — scheme, host, no
# trailing slash.
FRONTEND_URL=https://repomanager.example.pt

# Everything persisted: SQLite DB, session rows, daily backups, and the
# import/wiki clone scratch space. Put it outside the install directory so an
# upgrade never touches it. The service account needs Modify on this path.
DATA_DIR=C:\ProgramData\GitHubRepoManager\data

# NEVER true on a deployed instance. This is a BUILD-TIME flag for the
# frontend as well: a `npm run build` with it set to true ships a bundle that
# fabricates a signed-in session, permanently, for everyone it is served to.
VITE_MOCK_MODE=false

# ─────────────────────────────────────────────────────────────
# Secrets — generate, never hand-write
# ─────────────────────────────────────────────────────────────
#   node scripts/generate-secrets.mjs --append <path-to-this-file>
#
# Production boot aborts if SESSION_SECRET, WEBHOOK_SECRET or
# CREDENTIAL_ENCRYPTION_KEY is missing or shorter than 32 characters
# (server/lib/startup-secrets-check.js). API_KEY_SECRET is only checked for
# presence, and nothing compares the four for distinctness — that is exactly
# why you should generate them rather than hand-write them. Reusing one value
# across two of these collapses two separate compromises into one.
#
# CREDENTIAL_ENCRYPTION_KEY is the one you cannot lose: without it, every
# stored credential is unrecoverable. Back it up separately from the database.
SESSION_SECRET=
API_KEY_SECRET=
WEBHOOK_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# GitHub OAuth — required for login
# ─────────────────────────────────────────────────────────────
# https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:                 https://repomanager.example.pt
#   Authorization callback URL:   https://repomanager.example.pt/api/auth/callback
#
# GitHub matches the callback exactly. If IIS does not forward
# X-Forwarded-Proto, the app would otherwise build an http:// redirect_uri and
# every login dies with redirect_uri_mismatch — see the web.config in this
# folder and the allowedServerVariables step in the guide.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# Email — required in production
# ─────────────────────────────────────────────────────────────
# EMAIL_PROVIDER=console makes boot fail on a hosted install: license keys and
# retention warnings would be written to a log file and never delivered.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.pt

# ─────────────────────────────────────────────────────────────
# Operations
# ─────────────────────────────────────────────────────────────
# Defaults to 'warn' in production when unset. 'info' is a reasonable first
# week while you confirm the deployment, then drop it back.
LOG_LEVEL=warn

# Daily WAL-safe online backup of the SQLite DB. Leave DB_BACKUP_DIR unset to
# get <DATA_DIR>\backups; set an absolute path to write to a different volume
# (recommended — a backup on the same disk survives corruption, not disk loss).
# An EMPTY string disables backups entirely. Restore: docs/operations.md.
# Leave COMMENTED OUT for the default (<DATA_DIR>\backups). An empty
# assignment is NOT the same thing — db-backup.js reads an explicit empty
# string as "backups disabled".
# DB_BACKUP_DIR=
DB_BACKUP_KEEP=7

# Self-hosted Pro/Enterprise licence (grm_lic_*). Empty = Free tier.
LICENSE_KEY=

# Optional error tracking.
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────
# Optional integrations — leave blank unless you are enabling them
# ─────────────────────────────────────────────────────────────
# Stripe billing. STRIPE_WEBHOOK_SECRET and LICENSE_SIGNING_PRIVATE_KEY_PEM
# both become REQUIRED the moment STRIPE_SECRET_KEY is set (boot aborts
# otherwise). Webhook endpoint: https://<host>/api/v1/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LICENSE_SIGNING_PRIVATE_KEY_PEM=

# Azure DevOps OAuth (migration wizard). Redirect URI:
#   https://<host>/api/azure/oauth/callback
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Server-wide AI fallback key. Users normally bring their own via
# Settings → AI Configuration; leave empty for pure BYOK.
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# Do NOT set these on this deployment
# ─────────────────────────────────────────────────────────────
# ALLOW_MOCK_AUTH=true          → unauthenticated login endpoint; boot aborts
# ALLOW_CONSOLE_EMAIL=true      → single-user local installs only
# DISABLE_HTTPS_ENFORCEMENT=true→ IIS terminates real TLS; nothing to disable
