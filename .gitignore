# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Linting logs
lint_log*.txt

node_modules
dist
dist-ssr
dist/bundle-analysis.html
# Throwaway build outputs for the two build gates (tests/build/*.test.js).
# Separate dirs so the gates cannot clobber each other in parallel workers.
dist-honesty-check/
dist-budget-check/
coverage
*.local
.augment/
.agent/
# Root-anchored: unanchored names like `rules/` would silently swallow any
# future src/server folder with the same name.
/augment rules/
/rules/
/plans/
/Implementation/
.roo/
.superpowers/

# Environment files (NEVER commit credentials!)
# Pattern, not an enumeration: the old explicit list left .env.staging,
# .env.ci and every other future variant tracked by default, which is the
# wrong way round for a file class that exists to hold secrets. Only the two
# committed templates are re-included.
.env
.env.*
# Also the `<name>.env` shape, which the `.env*` patterns above do NOT match.
# deploy/iis/production.env.example invites exactly that filename once the
# `.example` suffix is dropped, and the deployment runbook has the operator
# running git in the same tree.
*.env
!.env.example
!.env.test
!*.env.example

# Database files (incl. SQLite WAL/journal sidecars — `*.db` alone does not
# match `repos.db-wal`, which appears whenever the server runs in WAL mode)
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
server/data/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code and MCP — personal tooling, not part of the project
.claude/
.playwright-mcp/
.superpowers/

# Dev directory — local workspace only
.dev/

# Git worktrees for isolated feature development
.worktrees/

# Screenshots and images (not part of source)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
# Exception: documentation images are part of the repo
!docs/images/*.png
!docs/images/*.jpg
# Exception: brand assets are shipped product, not screenshots. They are
# generated by scripts/gen-brand-raster.mjs and gated by tests/build/brand-assets
# — an ignored favicon would silently ship the browser's default icon.
!brand/*.png
!public/*.png
# Exception: Windows installer branding assets are part of the repo
!packaging/windows/assets/*.bmp

# Test reports and results
playwright-report/
test-results/

# Temporary development docs — root-anchored so they can never silently
# swallow legitimate files under docs/ (e.g. docs/reports/validation-*.md)
/validation-*.md
/dashboard-improved.md

# Temporary files
nul

# Keys and certificates (NEVER commit private key material)
# Same reasoning as the .env block: a single literal path only protected the
# one filename someone thought of. keys/public.pem is the sole exception —
# offline license verification needs it committed and it is public by
# definition.
*.pem
*.key
*.crt
*.pfx
*.p12
*.jks
!keys/public.pem

# Eval harness — local baseline files (per-dev, not committed)
server/evals/baseline.local.json
/dados.txt
