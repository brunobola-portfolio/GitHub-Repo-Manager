# ===========================================
# GitHub Repo Manager - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
#
# QUICK START (Demo Mode):
# -------------------------
# The app works out-of-the-box with NO configuration!
# Just run: npm run dev:all
# Mock mode is enabled by default, providing simulated data for all features.
#
# PRODUCTION SETUP:
# -----------------
# 1. Set VITE_MOCK_MODE=false
# 2. Configure GitHub OAuth (required for real GitHub data)
# 3. Set strong secrets for SESSION_SECRET, WEBHOOK_SECRET, CREDENTIAL_ENCRYPTION_KEY
# 4. Optionally configure AI providers (users set their own keys via Settings → AI Configuration)
# 5. See each section below for full details.

# ─────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────

# API Base URL (leave empty for same-origin, or set to your backend URL)
# In development, Vite proxies /api to the backend automatically
VITE_API_BASE_URL=

# Mock Mode — Controls whether the app uses simulated data
# true  = Demo mode with mock data (DEFAULT — no API keys needed)
# false = Production mode with real GitHub/AI APIs
VITE_MOCK_MODE=true

# ─────────────────────────────────────────────────────────────
# Core (required in production)
# ─────────────────────────────────────────────────────────────

# Environment: development | production | test
NODE_ENV=development

# Session secret — must be at least 32 random bytes in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=change-me-to-a-random-32-plus-byte-string

# API key signing secret — used to sign grm_live_* API keys issued to users.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
API_KEY_SECRET=change-me-to-a-random-32-plus-byte-string

# Webhook signing secret — REQUIRED IN PRODUCTION. In dev, leave empty
# to accept unsigned webhooks for ngrok/smee.io testing.
WEBHOOK_SECRET=

# Credential vault — AES-256-GCM key for encrypting user-stored API keys
# (BYOK provider keys, Azure PATs). Falls back to SESSION_SECRET if unset.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# GitHub OAuth (required for login)
# ─────────────────────────────────────────────────────────────
# How to obtain:
# 1. Go to https://github.com/settings/developers → OAuth Apps → New OAuth App
# 2. Homepage URL: http://localhost:5173
# 3. Authorization callback URL: http://localhost:3001/api/auth/callback
# 4. Copy Client ID and generate a Client Secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL for CORS and OAuth redirects
FRONTEND_URL=http://localhost:5173

# Backend server port
PORT=3001

# ─────────────────────────────────────────────────────────────
# AI — BYOK (Bring Your Own Key)
# ─────────────────────────────────────────────────────────────
# Users configure their own provider in Settings → AI Configuration.
# The server-side GEMINI_API_KEY below is an OPTIONAL fallback for demo
# mode and single-tenant self-hosts that prefer a shared key.

# Optional server-wide Gemini fallback key.
# Leave empty in multi-tenant deployments (set AI_REQUIRE_USER_CONFIG=true instead).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Set to 'true' in multi-tenant deployments to DISABLE the server-wide
# Gemini fallback and force every user to configure their own provider.
AI_REQUIRE_USER_CONFIG=

# Disable AI PR review even when AI is configured (e.g. cost control).
DISABLE_AI_REVIEW=

# ─────────────────────────────────────────────────────────────
# Azure DevOps (optional — migration features only)
# ─────────────────────────────────────────────────────────────
# How to obtain:
# 1. Go to https://dev.azure.com/{org}/_usersSettings/tokens
# 2. New Token → scopes: Code (Read & Write), Project (Read)
AZURE_PAT=

# ─────────────────────────────────────────────────────────────
# Email delivery (needed for Stripe license keys + G2 retention warnings)
# ─────────────────────────────────────────────────────────────
# 'console' (dev default — logs send attempts, doesn't deliver)
# 'resend'  (production — requires RESEND_API_KEY + EMAIL_FROM)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=no-reply@yourdomain.example

# ─────────────────────────────────────────────────────────────
# License issuance (needed if you enable Stripe billing)
# ─────────────────────────────────────────────────────────────
# Ed25519 PEM-encoded private key used to sign issued license keys.
# Generate via: node -e "import('./server/lib/license.js').then(m => m.generateKeyPair()).then(k => console.log(k.privateKey))"
# Required in production if STRIPE_SECRET_KEY is set.
LICENSE_SIGNING_PRIVATE_KEY_PEM=

# Self-hosted license key (grm_lic_*). Paste the value from your Stripe
# checkout email to unlock Pro/Enterprise tier on a self-hosted instance.
# Leave empty for Free tier.
LICENSE_KEY=

# ─────────────────────────────────────────────────────────────
# Data retention (G2)
# ─────────────────────────────────────────────────────────────
DATA_RETENTION_DAYS=365
DATA_RETENTION_WARNING_LEAD_DAYS=30

# ─────────────────────────────────────────────────────────────
# Stripe (optional — Pro/Enterprise subscription billing)
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# ─────────────────────────────────────────────────────────────
# Observability (optional)
# ─────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
REDIS_URL=

# ─────────────────────────────────────────────────────────────
# Database (optional — defaults to SQLite)
# ─────────────────────────────────────────────────────────────
# Uncomment to use PostgreSQL instead of SQLite for multi-instance deployments.
# DATABASE_URL=postgres://user:pass@localhost:5432/github_repo_manager

