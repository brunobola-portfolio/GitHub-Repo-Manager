# ===========================================
# GitHub Repo Manager - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
#
# QUICK START (Demo Mode):
# -------------------------
# The app works out-of-the-box with NO configuration!
# Just run: npm run dev:all
# Mock mode is enabled by default, providing simulated data for all features.
#
# PRODUCTION SETUP:
# -----------------
# 1. Set VITE_MOCK_MODE=false
# 2. Configure GitHub OAuth (required for real GitHub data)
# 3. Set strong secrets for SESSION_SECRET, WEBHOOK_SECRET, CREDENTIAL_ENCRYPTION_KEY
# 4. Optionally configure AI providers (users set their own keys via Settings → AI Configuration)
# 5. See each section below for full details.

# ─────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────

# API Base URL (leave empty for same-origin, or set to your backend URL)
# In development, Vite proxies /api to the backend automatically
VITE_API_BASE_URL=

# Mock Mode — Controls whether the app uses simulated data
# true  = Demo mode with mock data (DEFAULT — no API keys needed)
# false = Production mode with real GitHub/AI APIs
VITE_MOCK_MODE=true

# ─────────────────────────────────────────────────────────────
# Core (required in production)
# ─────────────────────────────────────────────────────────────

# Environment: development | production | test
NODE_ENV=development

# Session secret — must be at least 32 random bytes in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=change-me-to-a-random-32-plus-byte-string

# API key signing secret — used to sign grm_live_* API keys issued to users.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
API_KEY_SECRET=change-me-to-a-random-32-plus-byte-string

# Webhook signing secret — REQUIRED IN PRODUCTION. In dev, leave empty
# to accept unsigned webhooks for ngrok/smee.io testing.
WEBHOOK_SECRET=

# Credential vault — AES-256-GCM key for encrypting user-stored API keys
# (BYOK provider keys, Azure PATs). Falls back to SESSION_SECRET if unset.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# Key rotation (optional): to rotate CREDENTIAL_ENCRYPTION_KEY without stranding
# existing encrypted credentials, set the NEW key above and the OLD key here.
# Stored credentials keep decrypting with either key; every re-save re-encrypts
# under the new key. Remove this once all credentials have been re-saved.
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# ─────────────────────────────────────────────────────────────
# GitHub OAuth (required for login)
# ─────────────────────────────────────────────────────────────
# How to obtain:
# 1. Go to https://github.com/settings/developers → OAuth Apps → New OAuth App
# 2. Homepage URL: http://localhost:5173
# 3. Authorization callback URL: http://localhost:3001/api/auth/callback
# 4. Copy Client ID and generate a Client Secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL for CORS and OAuth redirects
FRONTEND_URL=http://localhost:5173

# Backend server port
PORT=3001

# Bind address (optional). Leave UNSET to bind all interfaces (unchanged
# default behavior). Self-hosted desktop installs (e.g. the Windows package)
# set HOST=127.0.0.1 so the OS firewall prompt never appears and the server
# is never exposed on the LAN by default.
HOST=

# ─────────────────────────────────────────────────────────────
# AI — BYOK (Bring Your Own Key)
# ─────────────────────────────────────────────────────────────
# Users configure their own provider in Settings → AI Configuration.
# The server-side GEMINI_API_KEY below is an OPTIONAL fallback for demo
# mode and single-tenant self-hosts that prefer a shared key.

# Optional server-wide Gemini fallback key.
# Leave empty in multi-tenant deployments (set AI_REQUIRE_USER_CONFIG=true instead).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Server-wide provider selection (the assistant is provider-neutral) ------
# Which provider the SERVER fallback uses for users without a BYOK config.
# One of: gemini (default) | anthropic | openai | openrouter | local
AI_PROVIDER=gemini
# Set the key + (optional) model for the provider chosen above. Only the one
# matching AI_PROVIDER is needed; defaults are sensible per provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# 'local' (LMStudio / Ollama) usually needs no key; set the model + endpoint.
LOCAL_API_KEY=
LOCAL_MODEL=
# Per-feature model override (optional), e.g. a stronger model for reviews:
#   AI_MODEL_CHAT=...  AI_MODEL_REVIEW=...  AI_MODEL_MIGRATION_RISK=...

# Set to 'true' in multi-tenant deployments to DISABLE the server-wide
# fallback and force every user to configure their own provider.
AI_REQUIRE_USER_CONFIG=

# Disable AI PR review even when AI is configured (e.g. cost control).
DISABLE_AI_REVIEW=

# --- Cost & safety controls (all optional) -----------------------------------
# Per-call output-token cap (OWASP LLM10). Default 2048; clamped to 256..8192.
AI_MAX_OUTPUT_TOKENS=
# Monthly per-user AI spend cap in US cents. 0 / unset = unlimited (disabled).
# e.g. 500 = a $5/user/month ceiling, enforced across the AI surface.
# Legacy flat override — takes precedence over the TIER_FEATURES default but
# is itself overridden by the tier-specific vars below, if set. Self-hosted
# AGPL deployments stay disabled-by-default unless one of these is set.
AI_SPEND_CAP_CENTS=

# Tier-specific AI spend cap overrides (US cents/month), for hosted operation.
# Recommended hosted values (not enforced by default — self-host stays opt-in):
#   AI_SPEND_CAP_CENTS_FREE=200        # $2.00/mo
#   AI_SPEND_CAP_CENTS_PRO=2000        # $20.00/mo
#   AI_SPEND_CAP_CENTS_ENTERPRISE=     # unset/disabled — contracted, trust-based
AI_SPEND_CAP_CENTS_FREE=
AI_SPEND_CAP_CENTS_PRO=
AI_SPEND_CAP_CENTS_ENTERPRISE=
# Base delay (ms) for exponential backoff on transient provider errors (def 400).
AI_RETRY_BASE_DELAY_MS=

# --- Operational flags -------------------------------------------------------
# Work Board AI endpoints are OFF unless this is exactly 'true'.
WORK_BOARD_AI_ENABLED=
# Allow loopback/private BYOK endpoint URLs (only meaningful with the 'local'
# provider). Set to 'true' to opt in; otherwise such endpoints are rejected (SSRF).
ALLOW_LOCAL_AI_ENDPOINTS=
# (BYOK credential encryption uses CREDENTIAL_ENCRYPTION_KEY — see the Security
# section above.)

# ─────────────────────────────────────────────────────────────
# Azure DevOps (optional — migration features only)
# ─────────────────────────────────────────────────────────────
# Personal Access Token — the simplest path.
# How to obtain:
# 1. Go to https://dev.azure.com/{org}/_usersSettings/tokens
# 2. New Token → scopes: Code (Read & Write), Project (Read)
AZURE_PAT=

# Azure AD / Entra ID OAuth (optional — only if you prefer interactive sign-in
# over PAT). Create an app registration at
# https://portal.azure.com → Entra ID → App registrations:
#   Redirect URI: http://localhost:3001/api/azure/oauth/callback
#   API permissions: Azure DevOps → user_impersonation
# Leave empty to fall back to AZURE_PAT.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ─────────────────────────────────────────────────────────────
# Email delivery (needed for Stripe license keys + G2 retention warnings)
# ─────────────────────────────────────────────────────────────
# 'console' (dev default — logs send attempts, doesn't deliver)
# 'resend'  (production — requires RESEND_API_KEY + EMAIL_FROM)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=no-reply@yourdomain.example

# Single-user/local installs only (e.g. the Windows package): downgrades the
# EMAIL_PROVIDER=console production boot error to a warning, since there is no
# one else to email and license/retention notices just log. Every other
# production secret/config guard is unaffected — do NOT set this on a hosted,
# multi-user deployment.
ALLOW_CONSOLE_EMAIL=

# ─────────────────────────────────────────────────────────────
# License issuance (needed if you enable Stripe billing)
# ─────────────────────────────────────────────────────────────
# Ed25519 PEM-encoded private key used to sign issued license keys.
# Generate via: node -e "import('./server/lib/license.js').then(m => m.generateKeyPair()).then(k => console.log(k.privateKey))"
# Required in production if STRIPE_SECRET_KEY is set.
LICENSE_SIGNING_PRIVATE_KEY_PEM=

# Self-hosted license key (grm_lic_*). Paste the value from your Stripe
# checkout email to unlock Pro/Enterprise tier on a self-hosted instance.
# Leave empty for Free tier.
LICENSE_KEY=

# ─────────────────────────────────────────────────────────────
# Data retention (G2)
# ─────────────────────────────────────────────────────────────
DATA_RETENTION_DAYS=365
DATA_RETENTION_WARNING_LEAD_DAYS=30

# GitHub event-table retention. The pr_events / issue_events /
# deployment_events / review_assignments / workflow_runs tables grow forever as
# webhooks stream in. The daily maintenance pass deletes rows older than this
# many days (batched to avoid long write locks). Default 365; set to 0 (or
# leave empty) to disable event purging entirely.
EVENT_RETENTION_DAYS=365

# ─────────────────────────────────────────────────────────────
# Database backups (SQLite only)
# ─────────────────────────────────────────────────────────────
# The daily maintenance pass writes a WAL-safe online backup
# (better-sqlite3 .backup()) of the SQLite database as a timestamped file.
# Enabled by default. Restore steps: docs/operations.md → "Backup & restore".
#
# Directory for backup files. Leave UNSET to default to a `backups/` folder
# next to the live DB (server/data/backups). Set an ABSOLUTE path to point at a
# separate mounted volume. Set to an empty string to DISABLE backups entirely.
DB_BACKUP_DIR=
# How many of the most-recent backups to keep (older ones are pruned). Default 7.
DB_BACKUP_KEEP=7

# ─────────────────────────────────────────────────────────────
# Stripe (optional — Pro/Enterprise subscription billing)
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
# Yearly price IDs are OPTIONAL. Leaving STRIPE_PRICE_PRO_YEARLY empty hides the
# monthly/yearly toggle on the pricing page (checkout stays monthly-only), so a
# "Save 20%" discount is never shown unless it maps to a real yearly checkout.
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# ─────────────────────────────────────────────────────────────
# Observability (optional)
# ─────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
REDIS_URL=

# Bearer token for the Prometheus scrape endpoint (GET /metrics). Leave unset
# to only allow access via an admin session (users.is_admin = 1) — GET
# /metrics is NEVER exposed unauthenticated either way. Set this when your
# scraper (Prometheus, Grafana Agent, ...) can't hold a browser session.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METRICS_TOKEN=

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
# SQLite (better-sqlite3) is the only supported database — there is no
# PostgreSQL or other backend. DATABASE_URL is optional and, if set, must be
# a `sqlite:` URL; leave it unset to use the default file under server/data/.
# See docs/operations.md for backup/restore and scale guidance.
# DATABASE_URL=sqlite:./server/data/manager.db

# Root directory for ALL persisted state: the SQLite DB + session store, the
# default backups/ dir (unless DB_BACKUP_DIR overrides it), and import/wiki
# clone scratch space. Leave UNSET to use `server/data` (unchanged default).
# Set an ABSOLUTE path when the app directory is read-only — the Windows
# package sets this to %LOCALAPPDATA%\GitHubRepoManager\data since an
# installed-to-Program-Files layout can't be written to.
DATA_DIR=

# ─────────────────────────────────────────────────────────────
# Update check
# ─────────────────────────────────────────────────────────────
# Notify-only "new version available" signal for self-hosters — no
# self-mutating auto-update. Checks the latest GitHub release tag against the
# running version; set to 'false' to disable the outbound GitHub API call
# entirely (GET /api/v1/system/update-check then just echoes the current
# version). Default: enabled.
UPDATE_CHECK=

# ─────────────────────────────────────────────────────────────
# Advanced / optional operator knobs (safe defaults; most self-hosts skip these)
# ─────────────────────────────────────────────────────────────
# Extra hostnames allowed for Azure DevOps Server (on-prem) imports, in addition
# to the built-in dev.azure.com / *.visualstudio.com allowlist. Comma-separated.
# Leave unset for Azure DevOps Cloud only. (On-prem Azure DevOps Server is roadmap.)
# ALLOWED_AZURE_HOSTS=

# Escape hatch to skip the HTTPS-only enforcement. NEVER set in production — the
# server logs a loud startup warning if this is true while NODE_ENV=production.
# DISABLE_HTTPS_ENFORCEMENT=false

# Disable the in-app first-run GitHub OAuth setup (POST /api/auth/setup-oauth).
# The endpoint already only works from loopback while OAuth is unconfigured;
# set 'true' to force .env editing as the only configuration channel.
# GRM_DISABLE_WEB_SETUP=false

# HMAC key for signing Work Board AI diff-handoff tokens. Falls back to a
# SESSION_SECRET-derived key if unset; set explicitly for multi-instance deploys.
# AI_DIFF_SIGNING_KEY=

# ─────────────────────────────────────────────────────────────
# AGPL §13 Source Disclosure
# ─────────────────────────────────────────────────────────────
# This project is licensed under AGPL v3. If you deploy a modified version as
# a network service, §13 requires you to offer users the corresponding source.
# The machine-readable offer is served at GET /api/v1/system/source and MUST
# remain publicly reachable (no auth). If you fork and modify, update the
# `sourceUrl` in server/routes/system.js to point at your fork.
