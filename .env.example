# ===========================================
# GitHub Repo Manager - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
#
# QUICK START (Demo Mode):
# -------------------------
# The app works out-of-the-box with NO configuration!
# Just run: npm run dev:all
# Mock mode is enabled by default, providing simulated data for all features.
#
# PRODUCTION SETUP:
# -----------------
# 1. Set VITE_MOCK_MODE=false
# 2. Configure GitHub OAuth (required for real GitHub data)
# 3. Optionally add GEMINI_API_KEY for AI features

# ============ FRONTEND ============

# API Base URL (leave empty for same-origin, or set to your backend URL)
# In development, Vite proxies /api to the backend automatically
VITE_API_BASE_URL=

# Mock Mode - Controls whether the app uses simulated data
# true  = Demo mode with mock data (DEFAULT - no API keys needed)
# false = Production mode with real GitHub/AI APIs
VITE_MOCK_MODE=true


# ============ BACKEND ============

# ----------------------------------
# GitHub OAuth App (Required for real GitHub data)
# ----------------------------------
# How to obtain:
# 1. Go to https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Fill in:
#    - Application name: GitHub Repo Manager (or your choice)
#    - Homepage URL: http://localhost:5173
#    - Authorization callback URL: http://localhost:3001/api/auth/callback
# 4. Click "Register application"
# 5. Copy the Client ID and generate a Client Secret
#
# Note: Without these, the app runs in mock mode with simulated data
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# Session secret for Express (use a random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-string

# Frontend URL for CORS and redirects
FRONTEND_URL=http://localhost:5173

# Backend server port
PORT=3001


# ----------------------------------
# AI Features (Optional - Backend Only)
# ----------------------------------
# SECURITY: This key MUST be set on the backend server only.
# Never expose this key to the frontend or client-side code.
#
# How to obtain:
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Click "Create API Key"
# 3. Copy the key and paste below
#
# Features enabled with this key:
# - AI Chat Assistant
# - Repository Analysis & Health Scores
# - Semantic Search (natural language repo search)
# - README Generation
# - Improvement Suggestions
#
# Note: Without this key, AI features return mock/placeholder responses
GEMINI_API_KEY=your_gemini_api_key

# Gemini Model (optional - defaults to gemini-2.5-flash)
#
# Available models (April 2026):
# ┌──────────────────────────┬──────────┬──────────┬─────────────────────────────────┐
# │ Model                    │ Status   │ Free?    │ Free Tier Limits                │
# ├──────────────────────────┼──────────┼──────────┼─────────────────────────────────┤
# │ gemini-2.5-flash         │ Stable   │ Yes      │ 10 RPM / 250 RPD / 250k TPM    │
# │ gemini-2.5-flash-lite    │ Stable   │ Yes      │ 15 RPM / 1000 RPD / 250k TPM   │
# │ gemini-3-flash-preview   │ Preview  │ Yes      │ Limited                         │
# │ gemini-2.5-pro           │ Stable   │ No       │ Paid only                       │
# │ gemini-3.1-pro-preview   │ Preview  │ No       │ Paid only                       │
# └──────────────────────────┴──────────┴──────────┴─────────────────────────────────┘
#
# Deprecated (do NOT use): gemini-2.0-flash-exp, gemini-1.5-flash, gemini-1.5-pro
# Pricing: https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=gemini-2.5-flash

# Gemini Embedding Model (optional - defaults to gemini-embedding-001)
# Used for semantic search and repository indexing
#
# Available:
#   gemini-embedding-001      — Text embeddings (stable, free)
#   gemini-embedding-2-preview — Multimodal embeddings (preview, free)
#
# Note: text-embedding-004 was shut down — use gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ----------------------------------
# Free AI Provider Alternatives (for reference)
# ----------------------------------
# The app currently uses Google Gemini. These are free-tier alternatives
# that could be integrated in the future (no credit card required):
#
# | Provider                | Free Limit               | Best For                    | URL                              |
# |-------------------------|--------------------------|-----------------------------|----------------------------------|
# | Google Gemini (current) | 250 RPD (Flash)          | Reasoning, embeddings       | https://aistudio.google.com      |
# | Google Gemini Flash-Lite| 1000 RPD                 | High-volume, lightweight    | https://aistudio.google.com      |
# | Groq                   | 14,400 req/day           | Fastest inference, chat     | https://console.groq.com         |
# | Mistral AI             | ~1B tokens/month         | Volume, code (Codestral)    | https://console.mistral.ai       |
# | OpenRouter             | 50 req/day (30+ models)  | Model variety               | https://openrouter.ai            |
# | Cloudflare Workers AI  | 10,000 neurons/day       | Edge deployment             | https://developers.cloudflare.com|
# | Hugging Face           | Monthly credits          | Embeddings, specialized NLP | https://huggingface.co           |


# ----------------------------------
# Azure DevOps (Optional)
# ----------------------------------
# Required only for Azure DevOps migration features
# How to obtain:
# 1. Go to https://dev.azure.com/{your-org}/_usersSettings/tokens
# 2. Click "New Token"
# 3. Give it a name and select scopes: Code (Read & Write), Project (Read)
# 4. Copy the token
#
# Note: Only needed if you want to import repos from Azure DevOps
AZURE_PAT=your_azure_personal_access_token


# ----------------------------------
# Webhook Security (Optional)
# ----------------------------------
# Secret for verifying GitHub webhook signatures (X-Hub-Signature-256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same secret in your GitHub webhook settings.
# Without this, webhook endpoints accept any payload (fine for development).
WEBHOOK_SECRET=


# ----------------------------------
# License Key (Optional - Self-Hosted Pro/Enterprise)
# ----------------------------------
# For self-hosted deployments, set a license key to unlock Pro or Enterprise features.
# Purchase a license at https://bolalabs.pt/license
# Without a key, the app runs with free-tier limits.
# LICENSE_KEY=grm_lic_...


# === Optional: Database (defaults to SQLite) ===
# Uncomment to use PostgreSQL instead of SQLite for multi-instance deployments.
# DATABASE_URL=postgres://user:pass@localhost:5432/github_repo_manager
# DATABASE_URL=sqlite:./server/data/manager.db

# === Optional: Redis (distributed sessions & job queues) ===
# Required for multi-instance deployments. Without Redis, sessions use SQLite (single-instance only).
# REDIS_URL=redis://localhost:6379

# === Optional: Billing (Stripe) ===
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...

# === Optional: Monitoring (Sentry) ===
# SENTRY_DSN=https://your-sentry-dsn
# VITE_SENTRY_DSN=https://your-frontend-sentry-dsn
