# Normalize JavaScript line endings to LF.
#
# Windows clients with core.autocrlf=true otherwise materialize .js files as
# CRLF on checkout, which breaks Vitest's ESM transformer when the file starts
# with a shebang (#!) — esbuild's transform mangles the shebang + CRLF
# combination and produces a "SyntaxError: Invalid or unexpected token" with
# no stack trace. Forcing LF on all JS/TS/JSON files eliminates the class
# of issue entirely.
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf

# YAML workflow files also rely on LF in GitHub Actions runners.
*.yml  text eol=lf
*.yaml text eol=lf

# Cryptographic keys (public) must not be mangled.
*.pem  text eol=lf

# Brand SVGs are GENERATED (scripts/gen-brand.mjs) and compared byte-for-byte
# by tests/build/brand-assets.test.js. Without this, a Windows checkout with
# core.autocrlf=true materializes them as CRLF while the generator writes LF,
# and the gate fails on every asset — green on a Linux runner, red on the
# developer's machine, for a difference no renderer can see.
*.svg  text eol=lf

# Binary assets: never touched, never diffed as text. Git usually infers this,
# but an explicit rule means a stray `text=auto` can't corrupt an icon.
*.ico   binary
*.png   binary
*.jpg   binary
*.bmp   binary
*.woff2 binary

# Shell scripts are always LF.
*.sh   text eol=lf
